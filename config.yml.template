# ============================================================
#  SuperGame5 (Cloud) — конфиг для GitHub Actions
#  Токен подставляется из секрета LICHESS_TOKEN при запуске.
#  НИКОГДА не вписывайте настоящий токен в этот файл!
# ============================================================
token: "__LICHESS_TOKEN__"
url: "https://lichess.org/"

engine:
  dir: "./engines/"
  # Fairy-Stockfish — шахматные варианты (atomic, antichess, horde и т.д.)
  name: "fairy-stockfish"
  # Stockfish 19 — классика и Chess960 (скачивается при старте Actions)
  standard_chess_name: "stockfish"
  # Тюнинг пули 30+0 перенесён из локального SuperGame5.
  # На 4-ядерном раннере лимит поднят 250->380: там каждый поток медленнее,
  # поэтому ищем дольше, чтобы компенсировать нехватку ядер.
  bullet_move_time: 380
  bullet_time_reserve: 1500
  bullet_time_divisor: 100
  bullet_ponder: true
  black_time_bonus: 1.35
  converting_time_bonus: 1.3
  converting_score: 100
  converted_score: 600
  variant_ponder: true
  debug: false
  working_dir: ""
  protocol: "uci"
  ponder: false

  polyglot:
    # Дебютная книга gm2001 для классики/Chess960 (лежит в репозитории, books/).
    # Книги для вариантов (antichess/horde/atomic .bin) на диске не нашлись —
    # если появятся, положите их в books/ и допишите пути ниже.
    enabled: true
    book:
      standard:
        - "./books/gm2001.bin"
    min_weight: 0
    selection: "best_move"
    max_depth: 30
    normalization: "none"

  draw_or_resign:
    resign_enabled: false
    resign_score: -1000
    resign_for_egtb_minus_two: false
    resign_moves: 3
    offer_draw_enabled: false
    offer_draw_score: 0
    offer_draw_for_egtb_zero: false
    offer_draw_moves: 10
    offer_draw_pieces: 10

  online_moves:
    max_out_of_book_moves: 0
    max_retries: 0
    chessdb_book:
      enabled: false
    lichess_cloud_analysis:
      enabled: false
    lichess_opening_explorer:
      enabled: false
    # Онлайн-таблички Lichess: покрывают atomic (до 7 фигур) и antichess
    online_egtb:
      enabled: true
      source: "lichess"
      min_time: 5
      max_time: 10800
      max_pieces: 6
      move_quality: "best"

  lichess_bot_tbs:
    # Локальных Syzygy на раннере GitHub нет — работает онлайн-EGTB выше
    syzygy:
      enabled: false
      paths: []
      max_pieces: 5
      move_quality: "best"
    gaviota:
      enabled: false
      paths: []
      max_pieces: 5
      min_dtm_to_consider_as_wdl_1: 120
      move_quality: "best"

  homemade_options:

  uci_options:
    # Раннер ubuntu-latest: 4 vCPU / 16 GB RAM.
    # 4 потока = максимум бесплатного GitHub (дома было 16, но тут потолок 4 ядра).
    Threads: 4
    Hash: 2048
    Move Overhead: 200
    Skill Level: 20
    UCI_LimitStrength: false
    UCI_ShowWDL: true

  silence_stderr: false

abort_time: 10
fake_think_time: false
rate_limiting_delay: 0
move_overhead: 200
max_takebacks_accepted: 0
quit_after_all_games_finish: false

correspondence:
  move_time: 120
  checkin_period: 300
  disconnect_time: 150
  ponder: false

challenge:
  concurrency: 1
  sort_by: "best"
  preference: "none"
  accept_bot: true
  only_bot: false
  max_increment: 0
  min_increment: 0
  # Пуля 30+0, как у локального SuperGame5
  max_base: 30
  min_base: 30
  max_days: 14
  min_days: 1
  variants:
    - standard
    - chess960
    - fromPosition
    - crazyhouse
    - antichess
    - atomic
    - horde
    - kingOfTheHill
    - racingKings
    - threeCheck
  time_controls:
    - bullet
  variant_time_controls:
    antichess:
      time_controls:
        - bullet
        - blitz
      min_base: 30
      max_base: 180
      max_increment: 2
    horde:
      time_controls:
        - bullet
        - blitz
      min_base: 30
      max_base: 180
      max_increment: 2
  modes:
    - casual
    - rated
  bullet_requires_increment: false
  max_simultaneous_games_per_user: 1
  recent_bot_challenge_age: 60
  max_recent_bot_challenges: 1

greeting:
  hello: "Good luck!"
  goodbye: "Good game!"
  hello_spectators: "Hi!"
  goodbye_spectators: "Thanks for watching!"

pgn_directory: "game_records"
pgn_file_grouping: "all"

matchmaking:
  allow_matchmaking: true
  allow_during_games: false
  rematch_opponents:
    - "AlphaWolf_BOT"
  challenge_variant: "random"
  challenge_timeout: 10
  challenge_idle_delay: 15
  challenge_retry_delay: 15
  challenge_initial_time:
    - 30
  challenge_increment:
    - 0
  opponent_min_rating: 2800
  opponent_max_rating: 4000
  opponent_rating_difference: 1000
  rating_preference: "high"
  challenge_mode: "rated"
  challenge_filter: "fine"
  include_challenge_block_list: false
  overrides:
    antichess_blitz:
      challenge_variant: "antichess"
      challenge_initial_time:
        - 180
      challenge_increment:
        - 0
    horde_blitz:
      challenge_variant: "horde"
      challenge_initial_time:
        - 180
      challenge_increment:
        - 0
  block_list: []
  online_block_list: []
  allow_list: []
